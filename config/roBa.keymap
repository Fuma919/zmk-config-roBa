#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <5>;

    scroll-layers = <7>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

&mkp_input_listener { input-processors = <&zip_temp_layer 5 10000>; };

/ {
    trackball_dpi_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        dpi_slow {
            layers = <6>;
            input-processors = <&zip_xy_scaler 1 32>;
        };
    };

    combos {
        compatible = "zmk,combos";

        to_layer_slow {
            bindings = <&lt 6 RIGHT_CONTROL>;
            key-positions = <7 8>;
        };

        mac_eng {
            bindings = <&to_layer_0 LANG2>;
            key-positions = <11 12>;
        };

        mac_jpn {
            bindings = <&to_layer_0 LANG1>;
            key-positions = <19 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 8 Q    &kp W      &kp E             &kp R  &kp T                                                      &kp Y  &kp U  &lt 7 I    &lt 6 O  &kp P
&kp A      &kp S      &kp D             &kp F  &kp G               &kp GLOBE               &kp SLASH      &kp H  &kp J  &kp K      &kp L    &kp ENTER
&kp Z      &kp X      &kp C             &kp V  &kp B               &lt 4 AT                &kp SEMI       &kp N  &kp M  &kp COMMA  &kp DOT  &kp MINUS
&kp LCTRL  &kp SPACE  &mt LEFT_ALT TAB  &mo 2  &mt LEFT_GUI SPACE  &mt LEFT_SHIFT TAB      &kp BACKSPACE  &mo 3                             &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        WIN {
            bindings = <
&trans        &trans  &trans  &trans              &trans                                                       &trans            &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans              &trans                  &kp LANG_ZENKAKUHANKAKU      &trans  &trans            &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans              &trans                  &trans                       &trans  &trans            &trans  &trans  &trans  &trans
&kp LEFT_GUI  &trans  &trans  &lt 4 INT_MUHENKAN  &mt LEFT_CONTROL SPACE  &trans                       &trans  &lt 3 INT_HENKAN                          &trans
            >;
        };

        ARR_FN {
            bindings = <
&kp CAPS      &trans          &kp UP_ARROW  &trans           &trans                                    &kp F1                &kp F2           &kp F3  &kp F4  &kp F5
&kp LEFT_ALT  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &trans  &trans      &kp LS(LG(NUMBER_3))  &kp F6                &kp F7           &kp F8  &kp F9  &kp F10
&trans        &trans          &trans        &trans           &trans  &trans      &kp LS(LG(NUMBER_4))  &kp LS(LG(NUMBER_5))  &kp PRINTSCREEN  &trans  &trans  &kp F11
&trans        &trans          &trans        &trans           &trans  &trans      &trans                &trans                                                 &kp F12
            >;
        };

        NUM_SYM {
            bindings = <
&kp KP_MINUS   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS                                 &kp APOS        &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH
&kp KP_DIVIDE  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MULTIPLY  &kp CARET        &kp EXCL  &kp GRAVE       &trans             &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
&kp NUMBER_0   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_EQUAL     &kp PERCENT      &kp AMPS  &kp LEFT_BRACE  &kp RIGHT_BRACE    &trans                &trans                 &kp TILDE
&kp HASH       &kp DOLLAR    &trans        &trans        &trans           &trans           &trans    &trans                                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        WDW_SYM {
            bindings = <
&kp LS(LC(LA(Q)))    &kp LS(LA(LC(W)))  &kp LC(LS(E))      &kp LS(LA(LC(R)))  &kp LS(LA(LC(T)))                        &kp SQT         &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH
&kp LEFT_ALT         &kp LC(LS(S))      &kp LC(LS(D))      &kp LC(LS(F))      &kp C_PLAY_PAUSE   &trans      &kp EXCL  &kp GRAVE       &trans             &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
&kp C_VOICE_COMMAND  &trans             &kp LS(LA(LC(C)))  &kp C_VOL_DN       &kp C_VOL_UP       &trans      &kp AMPS  &kp LEFT_BRACE  &kp RIGHT_BRACE    &trans                &trans                 &kp TILDE
&kp LA(LC(F5))       &kp C_BRI_DN       &kp C_BRI_UP       &trans             &trans             &trans      &kp DEL   &trans                                                                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        DPI_SLOW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans        &kp LS(LA(LC(E)))  &kp LS(LA(LC(R)))  &to 0                            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &kp N4        &trans             &trans             &tog 1  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2       &kp NUMBER_3       &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans             &trans             &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_10 {
            bindings = <
&kp KP_MINUS   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS                               &kp C_VOL_DN      &kp LG(MINUS)   &kp UP_ARROW    &kp LG(PLUS)     &kp C_VOL_UP
&kp KP_DIVIDE  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MULTIPLY  &kp CARET        &trans  &kp C_MUTE        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RIGHT_GUI
&kp NUMBER_0   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_EQUAL     &kp PERCENT      &trans  &kp C_PLAY_PAUSE  &trans          &trans          &trans           &kp C_BRI_UP
&kp HASH       &kp DOLLAR    &trans        &trans        &trans           &trans           &trans  &trans                                                             &kp C_BRI_DN
            >;

            sensor-bindings = <&inc_dec_kp (LC(PAGE_UP)) LC(PAGE_DOWN)>;
        };
    };
};
